<?xml version="1.0" encoding="utf-8"?>
<!-- HSTREAM : konteyner + ozel yukleme animasyonu
     (koyu daire icinde mor halka; media3'un varsayilan yerine) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- : kontroller 3 sn sonra topluca kaybolur - Kotlin'de
         ayarlanir (media3'te bu XML attribute YOK - AAPT hata verdi) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="surface_view"
        app:resize_mode="fit"
        app:show_subtitle_button="true"
        app:auto_show="true"
        app:controller_layout_id="@layout/custom_player_control_view" />

    <FrameLayout
        android:id="@+id/hs_yukleniyor"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_gravity="center"
        android:background="@drawable/hs_circle_koyu">

        <!-- : indeterminate + dairesel stil = GERCEKTEN donen mor halka
             (default determinate modda sabit kaliyordu) -->
        <ProgressBar
            style="@android:style/Widget.Material.ProgressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#FFA78BFA" />
    </FrameLayout>
</FrameLayout>
